<body>
<div id="app">

  <button class="audio-toggle" id="audio-toggle" onclick="toggleAudio()" title="Toggle sound">🔊</button>

  <!-- ======== TITLE ======== -->
  <div id="title" class="screen active scanlines grain vignette">
