/* ======================================================================
   STATE
====================================================================== */
let state = {
  mode: "solo", // or "multi"
  players: [], // [{name, archetype, lives, perkUses, freeMissUsed, reviveUsed}]
  currentPlayerIdx: 0,
  pickingPlayerIdx: 0, // for selection phase
  levelIdx: 0,
  qIdx: 0,
  chaseDistance: 100,
  usedQuestions: {},
  currentQuestion: null,
  totalCorrect: 0,
  totalAnswered: 0,
  lungeTimer: null
};

/* ======================================================================
   TITLE / MODE
====================================================================== */
function chooseMode(mode) {
  state.mode = mode;
  initAudio();
  if (audioCtx && audioCtx.state === "suspended") audioCtx.resume();
  if (mode === "solo") {
    state.players = [{ name: "Survivor", archetype: null, lives: 0, perkUses: 0, freeMissUsed: false, reviveUsed: false }];
    state.pickingPlayerIdx = 0;
    show("select");
    renderArchetypes();
  } else {
    show("mp-setup");
    renderPlayerCount();
  }
}

function renderPlayerCount() {
  document.querySelectorAll(".pc-btn").forEach(b => b.classList.remove("selected"));
  document.getElementById("name-inputs").innerHTML = "";
  document.getElementById("mp-continue").style.opacity = "0.3";
  document.getElementById("mp-continue").style.pointerEvents = "none";
}

function setPlayerCount(n) {
  document.querySelectorAll(".pc-btn").forEach(b => {
    b.classList.toggle("selected", parseInt(b.dataset.n) === n);
  });
  const wrap = document.getElementById("name-inputs");
  wrap.innerHTML = "";
  state.players = [];
  for (let i = 0; i < n; i++) {
    const inp = document.createElement("input");
    inp.className = "name-input";
    inp.placeholder = `Player ${i+1}`;
    inp.value = `Player ${i+1}`;
    inp.maxLength = 16;
    inp.dataset.idx = i;
    inp.oninput = checkMpReady;
    wrap.appendChild(inp);
    state.players.push({ name: `Player ${i+1}`, archetype: null, lives: 0, perkUses: 0, freeMissUsed: false, reviveUsed: false });
  }
  checkMpReady();
}

function checkMpReady() {
  const inputs = document.querySelectorAll(".name-input");
  const allFilled = [...inputs].every(i => i.value.trim().length > 0);
  const btn = document.getElementById("mp-continue");
  btn.style.opacity = allFilled ? "1" : "0.3";
  btn.style.pointerEvents = allFilled ? "auto" : "none";
}

function mpContinue() {
  const inputs = document.querySelectorAll(".name-input");
  inputs.forEach(i => {
    state.players[parseInt(i.dataset.idx)].name = i.value.trim() || `Player ${parseInt(i.dataset.idx)+1}`;
  });
  state.pickingPlayerIdx = 0;
  show("select");
  renderArchetypes();
}

/* ======================================================================
   SELECT
====================================================================== */
function renderArchetypes() {
  // Show who's picking
  const picker = document.getElementById("current-picker");
  const p = state.players[state.pickingPlayerIdx];
  if (state.mode === "multi") {
    picker.textContent = `${p.name}, choose your fate`;
    picker.style.display = "block";
  } else {
    picker.style.display = "none";
  }

  // Figure out which archetypes are taken
  const takenIds = state.players
    .filter((pl, i) => i < state.pickingPlayerIdx && pl.archetype)
    .map(pl => pl.archetype.id);

  const wrap = document.getElementById("archetypes");
  wrap.innerHTML = "";
  ARCHETYPES.forEach(a => {
    const taken = takenIds.includes(a.id);
    const div = document.createElement("div");
    div.className = "archetype" + (taken ? " taken" : "");
    if (!taken) div.onclick = () => selectArchetype(a.id);
    div.dataset.id = a.id;
    div.innerHTML = `
      <div class="icon">${a.icon}</div>
      <h3>${a.name}${taken ? '<span class="taken-badge">TAKEN</span>' : ''}</h3>
      <div class="desc">${a.desc}</div>
      <div class="stats">
        ${a.stats.map(s => `<div class="stat ${s.type}"><span>${s.label}</span><span>${s.value}</span></div>`).join("")}
      </div>
    `;
    wrap.appendChild(div);
  });

  document.getElementById("confirm-btn").classList.remove("ready");
  state.players[state.pickingPlayerIdx].archetype = null;
}

function selectArchetype(id) {
  state.players[state.pickingPlayerIdx].archetype = ARCHETYPES.find(a => a.id === id);
  document.querySelectorAll(".archetype").forEach(el => {
    el.classList.toggle("selected", el.dataset.id === id);
  });
  document.getElementById("confirm-btn").classList.add("ready");
}

function confirmArchetype() {
  if (!state.players[state.pickingPlayerIdx].archetype) return;
  state.pickingPlayerIdx++;
  if (state.pickingPlayerIdx < state.players.length) {
    renderArchetypes();
  } else {
    goStory();
  }
}

function goStory() {
  show("story");
  startAmbient();
  setTimeout(() => playStinger("scare"), 6800);
}

function backToTitle() {
  stopAmbient(); stopHeartbeat();
  clearInterval(state.lungeTimer);
  show("title");
}

function show(id) {
  document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
}

/* ======================================================================
   GAME START
====================================================================== */
function startGame() {
  // Initialize each player's lives/perks
  state.players.forEach(p => {
    p.lives = p.archetype.lives;
    p.perkUses = p.archetype.perk.uses;
    p.freeMissUsed = false;
    p.reviveUsed = false;
  });
  state.currentPlayerIdx = 0;
  state.levelIdx = 0;
  state.qIdx = 0;
  state.chaseDistance = 100;
  state.usedQuestions = {};
  state.totalCorrect = 0;
  state.totalAnswered = 0;

  show("game");
  startHeartbeat(70);
  startKillerLungeLoop();
  startLevel();
}

function startLevel() {
  const level = LEVELS[state.levelIdx];
  const bg = document.getElementById("game-bg");
  bg.className = "game-bg " + level.vibe;
  // Recreate parallax layers
  bg.innerHTML = `<div class="parallax-layer l1"></div><div class="parallax-layer l2"></div><div class="parallax-layer l3"></div>`;
  document.getElementById("killer-icon").textContent = level.killer;
  document.getElementById("player-icon").textContent = level.player;

  // Update killer silhouette (SVG)
  const sil = document.getElementById("killer-silhouette");
  sil.innerHTML = `<svg viewBox="0 0 120 200" xmlns="http://www.w3.org/2000/svg" width="120" height="180">
    <path d="${level.silhouette}" fill="none" stroke="#000" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="${level.silhouette}" fill="#000" opacity="0.7"/>
  </svg>`;

  state.chaseDistance = 100;
  state.qIdx = 0;
  renderProgressDots(level.questions);
  spawnParticles(level.vibe);
  updateHUD();
  showLevelIntro(level);
}

function renderProgressDots(count) {
  const wrap = document.getElementById("progress-dots");
  wrap.innerHTML = "";
  for (let i = 0; i < count; i++) {
    const d = document.createElement("div");
    d.className = "dot";
    wrap.appendChild(d);
  }
}

function updateProgressDots() {
  const dots = document.querySelectorAll(".dot");
  dots.forEach((d, i) => {
    d.classList.remove("done", "current");
    if (i < state.qIdx) d.classList.add("done");
    else if (i === state.qIdx) d.classList.add("current");
  });
}

function showLevelIntro(level) {
  const intro = document.getElementById("level-intro");
  intro.innerHTML = `
    <div class="level-num">LEVEL ${level.num} / ${LEVELS.length}</div>
    <div class="level-title">${level.name}</div>
    <div class="level-sub">${level.sub}</div>
  `;
  intro.style.display = "flex";
  intro.style.animation = "none";
  void intro.offsetWidth;
  intro.style.animation = "levelFade 3.2s forwards";
  setTimeout(() => {
    intro.style.display = "none";
    nextQuestion();
  }, 3200);
}

/* ======================================================================
   PARTICLES
====================================================================== */
function spawnParticles(vibe) {
  const wrap = document.getElementById("particles");
  wrap.innerHTML = "";
  let config = { count: 0, color: "#fff", size: [1, 2], speed: [10, 20] };

  if (vibe === "vibe-woods") config = { count: 20, color: "rgba(255,255,255,0.3)", size: [1, 2], speed: [8, 15] }; // fireflies
  else if (vibe === "vibe-saw") config = { count: 15, color: "rgba(200,100,50,0.4)", size: [1, 3], speed: [20, 40] }; // sparks
  else if (vibe === "vibe-psych") config = { count: 30, color: "rgba(180,160,220,0.3)", size: [1, 4], speed: [5, 12] }; // floating
  else if (vibe === "vibe-jhorror") config = { count: 10, color: "rgba(255,255,255,0.2)", size: [1, 2], speed: [15, 25] };
  else if (vibe === "vibe-folk") config = { count: 25, color: "rgba(255,200,100,0.5)", size: [1, 3], speed: [8, 18] }; // embers
  else if (vibe === "vibe-zombie") config = { count: 20, color: "rgba(120,50,30,0.4)", size: [2, 5], speed: [8, 15] }; // ash/dust
  else if (vibe === "vibe-cosmic") config = { count: 40, color: "rgba(100,200,255,0.4)", size: [1, 2], speed: [5, 10] }; // stars
  else if (vibe === "vibe-cryptid") config = { count: 30, color: "rgba(100,130,110,0.3)", size: [2, 5], speed: [6, 14] }; // fog motes
  else if (vibe === "vibe-truecrime") config = { count: 15, color: "rgba(200,180,140,0.3)", size: [1, 2], speed: [10, 20] }; // paper dust
  else if (vibe === "vibe-boss") config = { count: 50, color: "rgba(255,50,80,0.4)", size: [1, 4], speed: [10, 30] }; // chaos embers

  for (let i = 0; i < config.count; i++) {
    const p = document.createElement("div");
    p.className = "particle";
    const size = config.size[0] + Math.random() * (config.size[1] - config.size[0]);
    const duration = config.speed[0] + Math.random() * (config.speed[1] - config.speed[0]);
    const delay = Math.random() * duration;
    const startX = Math.random() * 100;
    const drift = (Math.random() - 0.5) * 100;
    p.style.cssText = `
      width: ${size}px; height: ${size}px;
      background: ${config.color};
      left: ${startX}%;
      top: 110%;
      box-shadow: 0 0 ${size * 2}px ${config.color};
      animation: floatUp ${duration}s linear ${-delay}s infinite;
      --drift: ${drift}px;
    `;
    wrap.appendChild(p);
  }
  // Inject keyframes if not present
  if (!document.getElementById("particle-keyframes")) {
    const style = document.createElement("style");
    style.id = "particle-keyframes";
    style.textContent = `
      @keyframes floatUp {
        from { transform: translateY(0) translateX(0); opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        to { transform: translateY(-120vh) translateX(var(--drift)); opacity: 0; }
      }
    `;
    document.head.appendChild(style);
  }
}

/* ======================================================================
   KILLER SILHOUETTE LUNGE — random scare moments
====================================================================== */
function startKillerLungeLoop() {
  clearInterval(state.lungeTimer);
  state.lungeTimer = setInterval(() => {
    // More frequent lunges when the chase is closer
    const chance = state.chaseDistance < 50 ? 0.4 : 0.15;
    if (Math.random() < chance) {
      triggerLunge();
    }
  }, 6000);
}

function triggerLunge() {
  const sil = document.getElementById("killer-silhouette");
  sil.classList.remove("lunge");
  void sil.offsetWidth;
  // Position it randomly on-screen during lunge
  const x = 20 + Math.random() * 60;
  sil.style.left = x + "%";
  sil.classList.add("lunge");
  playStinger("lunge");
  setTimeout(() => {
    sil.classList.remove("lunge");
    sil.style.left = "-150px";
  }, 900);
}

/* ======================================================================
   QUESTIONS
====================================================================== */
function nextQuestion() {
  const level = LEVELS[state.levelIdx];
  if (state.qIdx >= level.questions) {
    levelComplete();
    return;
  }

  const poolKey = level.poolKey;
  const pool = QUESTIONS[poolKey];
  if (!state.usedQuestions[poolKey]) state.usedQuestions[poolKey] = new Set();

  let available = pool.map((_, i) => i).filter(i => !state.usedQuestions[poolKey].has(i));
  if (available.length === 0) {
    state.usedQuestions[poolKey] = new Set();
    available = pool.map((_, i) => i);
  }
  const poolIdx = available[Math.floor(Math.random() * available.length)];
  state.usedQuestions[poolKey].add(poolIdx);
  const q = pool[poolIdx];
  state.currentQuestion = q;

  document.getElementById("category").textContent = level.category;
  document.getElementById("question-text").textContent = q.q;

  // Turn indicator for multiplayer
  if (state.mode === "multi") {
    const ti = document.getElementById("turn-indicator");
    const p = state.players[state.currentPlayerIdx];
    ti.textContent = `${p.name}'s turn — ${p.archetype.name}`;
    ti.style.display = "block";
  } else {
    document.getElementById("turn-indicator").style.display = "none";
  }

  // Re-trigger fadeIn
  document.getElementById("category").style.animation = "none";
  document.getElementById("question-text").style.animation = "none";
  void document.getElementById("category").offsetWidth;
  document.getElementById("category").style.animation = "fadeIn 0.5s 0.1s forwards";
  document.getElementById("question-text").style.animation = "fadeIn 0.5s 0.3s forwards";

  const answersDiv = document.getElementById("answers");
  answersDiv.innerHTML = "";
  const letters = ["A", "B", "C", "D"];
  q.a.forEach((answer, i) => {
    const btn = document.createElement("button");
    btn.className = "answer";
    btn.innerHTML = `<span class="letter">${letters[i]}</span><span>${answer}</span>`;
    btn.onclick = () => handleAnswer(i, q.c, btn);
    answersDiv.appendChild(btn);
  });

  updateHUD();
  updatePerkButton();
  updateProgressDots();
  updateHeartbeatIntensity();
}

function handleAnswer(chosen, correct, btn) {
  const all = document.querySelectorAll(".answer");
  all.forEach(a => a.classList.add("locked"));
  state.totalAnswered++;
  const currentPlayer = state.players[state.currentPlayerIdx];

  if (chosen === correct) {
    btn.classList.add("correct");
    state.totalCorrect++;
    flash("green");
    playStinger("correct");
    state.chaseDistance = Math.min(100, state.chaseDistance + 8);
    updateHUD();
    setTimeout(() => {
      state.qIdx++;
      rotateTurn();
      nextQuestion();
    }, 900);
  } else {
    btn.classList.add("wrong");
    all[correct].classList.add("correct");
    flash("red");
    playStinger("wrong");

    let lossMultiplier = 1;
    if (currentPlayer.archetype.id === "skeptic" && !currentPlayer.freeMissUsed) {
      currentPlayer.freeMissUsed = true;
      lossMultiplier = 0;
      showToast("COOL HEAD — the blow glances off");
    } else if (currentPlayer.archetype.id === "nerd") {
      lossMultiplier = 1.3;
    }

    const baseLoss = 22 + (state.levelIdx * 2);
    const loss = Math.round(baseLoss * lossMultiplier);
    state.chaseDistance = Math.max(0, state.chaseDistance - loss);

    if (state.chaseDistance <= 0) {
      currentPlayer.lives--;
      updateHUD();
      if (currentPlayer.lives <= 0) {
        if (currentPlayer.archetype.id === "final_girl" && !currentPlayer.reviveUsed) {
          currentPlayer.reviveUsed = true;
          currentPlayer.lives = 1;
          state.chaseDistance = 60;
          showToast("SECOND CHANCE — you crawl away from death");
          updateHUD();
          setTimeout(() => {
            state.qIdx++;
            rotateTurn();
            nextQuestion();
          }, 1400);
          return;
        }
        // Check multi-player: if any player alive, rotate to them
        if (state.mode === "multi" && state.players.some(p => p.lives > 0)) {
          showToast(`${currentPlayer.name} has fallen...`);
          setTimeout(() => {
            rotateTurn(true); // force skip dead players
            state.qIdx = 0; // restart level
            state.chaseDistance = 100;
            updateHUD();
            showToast("LEVEL RESTARTS FROM QUESTION 1");
            setTimeout(() => nextQuestion(), 1400);
          }, 1400);
          return;
        }
        setTimeout(() => gameOver(false), 1200);
        return;
      } else {
        // Lost life, restart level from q1
        showToast(`YOU'RE HIT — BACK TO QUESTION 1`);
        state.qIdx = 0;
        state.chaseDistance = 100;
        setTimeout(() => nextQuestion(), 1400);
        return;
      }
    }
    updateHUD();
    setTimeout(() => {
      state.qIdx++;
      rotateTurn();
      nextQuestion();
    }, 1400);
  }
}

function rotateTurn(forceSkipDead = false) {
  if (state.mode !== "multi") return;
  let tries = 0;
  do {
    state.currentPlayerIdx = (state.currentPlayerIdx + 1) % state.players.length;
    tries++;
  } while (state.players[state.currentPlayerIdx].lives <= 0 && tries < state.players.length * 2);
}

function levelComplete() {
  state.levelIdx++;
  if (state.levelIdx >= LEVELS.length) {
    gameOver(true);
  } else {
    showToast("LEVEL CLEARED — the night grows deeper");
    setTimeout(() => startLevel(), 1400);
  }
}

/* ======================================================================
   PERKS
====================================================================== */
function usePerk() {
  const p = state.players[state.currentPlayerIdx];
  if (p.perkUses <= 0) return;
  const perk = p.archetype.perk;

  if (perk.type === "skip") {
    p.perkUses--;
    showToast("SKIPPED — the question fades");
    setTimeout(() => {
      state.qIdx++;
      rotateTurn();
      nextQuestion();
    }, 700);
  } else if (perk.type === "fiftyfifty") {
    const answers = document.querySelectorAll(".answer");
    if (!state.currentQuestion) return;
    p.perkUses--;
    const wrongs = [0,1,2,3].filter(i => i !== state.currentQuestion.c);
    const toRemove = wrongs.sort(() => Math.random() - 0.5).slice(0, 2);
    toRemove.forEach(i => {
      answers[i].classList.add("locked");
      answers[i].style.opacity = "0.2";
      answers[i].style.textDecoration = "line-through";
    });
    showToast("FIFTY-FIFTY — two lies revealed");
  } else if (perk.type === "reveal") {
    const answers = document.querySelectorAll(".answer");
    if (!state.currentQuestion) return;
    p.perkUses--;
    answers[state.currentQuestion.c].style.borderColor = "#6ab04c";
    answers[state.currentQuestion.c].style.boxShadow = "0 0 20px rgba(106,176,76,0.5)";
    showToast("GENRE SAVVY — the truth glows");
  } else if (perk.type === "pushback") {
    p.perkUses--;
    state.chaseDistance = Math.min(100, state.chaseDistance + 30);
    updateHUD();
    showToast("ADRENALINE — you shove them back");
  }
  updatePerkButton();
}

function updatePerkButton() {
  const btn = document.getElementById("perk-btn");
  const p = state.players[state.currentPlayerIdx];
  if (!p || !p.archetype) return;
  const perk = p.archetype.perk;
  btn.textContent = `⚡ ${perk.name} (${p.perkUses})`;
  btn.disabled = p.perkUses <= 0 || perk.type === "revive" || perk.type === "nocost";
  if (perk.type === "revive") btn.textContent = `🛡️ ${perk.name} (auto)`;
  if (perk.type === "nocost") btn.textContent = `🧊 ${perk.name} (auto)`;
}

/* ======================================================================
   HUD
====================================================================== */
function updateHUD() {
  const hud = document.getElementById("hud");
  hud.innerHTML = "";

  // Player blocks
  state.players.forEach((p, i) => {
    if (!p.archetype) return;
    const isCurrent = (i === state.currentPlayerIdx);
    const block = document.createElement("div");
    block.className = "hud-block" + (isCurrent ? " active" : "");
    let livesHtml = "";
    for (let j = 0; j < p.archetype.lives; j++) {
      livesHtml += `<svg class="heart${j >= p.lives ? " lost" : ""}" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 21s-7-4.35-7-10a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 5.65-7 10-7 10z"/></svg>`;
    }
    block.innerHTML = `
      <div class="hud-label">${p.archetype.icon} ${p.name}</div>
      <div class="hud-value">${p.archetype.name}</div>
      <div class="lives">${livesHtml}</div>
    `;
    hud.appendChild(block);
  });

  // Level/question progress
  const level = LEVELS[state.levelIdx];
  const progBlock = document.createElement("div");
  progBlock.className = "hud-block";
  progBlock.innerHTML = `
    <div class="hud-label">Level ${level ? level.num : 1}</div>
    <div class="hud-value">${Math.min(state.qIdx + 1, level ? level.questions : 15)} / ${level ? level.questions : 15}</div>
  `;
  hud.appendChild(progBlock);

  // Chase
  const killer = document.getElementById("killer-icon");
  const track = document.querySelector(".chase-track");
  if (track) {
    const trackWidth = track.offsetWidth;
    const killerPos = ((100 - state.chaseDistance) / 100) * (trackWidth - 44);
    killer.style.left = killerPos + "px";
  }

  const label = document.getElementById("distance");
  if (state.chaseDistance > 70) label.textContent = "SAFE DISTANCE";
  else if (state.chaseDistance > 40) label.textContent = "THEY'RE GAINING";
  else if (state.chaseDistance > 15) label.textContent = "TOO CLOSE";
  else label.textContent = "RIGHT BEHIND YOU";
}

function updateHeartbeatIntensity() {
  if (!audioEnabled) return;
  let bpm = 70;
  if (state.chaseDistance < 70) bpm = 90;
  if (state.chaseDistance < 40) bpm = 120;
  if (state.chaseDistance < 15) bpm = 160;
  startHeartbeat(bpm);
}

function flash(color) {
  const f = document.getElementById("flash");
  f.className = "flash " + color;
  setTimeout(() => f.className = "flash", 600);
}

function showToast(msg) {
  const intro = document.getElementById("level-intro");
  intro.innerHTML = `<div class="level-sub" style="font-size:22px;color:#c1121f;letter-spacing:0.3em;">${msg}</div>`;
  intro.style.display = "flex";
  intro.style.animation = "none";
  void intro.offsetWidth;
  intro.style.animation = "levelFade 1.3s forwards";
  setTimeout(() => intro.style.display = "none", 1300);
}

/* ======================================================================
   GAME OVER
====================================================================== */
function gameOver(survived) {
  stopHeartbeat(); stopAmbient();
  clearInterval(state.lungeTimer);

  const title = document.getElementById("end-title");
  const stats = document.getElementById("end-stats");
  const quote = document.getElementById("end-quote");

  if (survived) {
    title.textContent = "YOU SURVIVED";
    title.className = "end-title survive";
    const survivors = state.players.filter(p => p.lives > 0);
    if (survivors.length > 0) {
      quote.textContent = `"${survivalQuotes[survivors[0].archetype.id] || 'You made it. Until the sequel.'}"`;
    }
  } else {
    title.textContent = "YOU DIED";
    title.className = "end-title death";
    playStinger("wrong");
    const lastPlayer = state.players[state.currentPlayerIdx];
    quote.textContent = `"${deathQuotes[lastPlayer.archetype.id] || 'Another name carved in the bark.'}"`;
  }

  const accuracy = state.totalAnswered > 0
    ? Math.round((state.totalCorrect / state.totalAnswered) * 100) : 0;

  let playerLines = state.players.map(p => {
    const status = p.lives > 0 ? `❤️ ${p.lives} left` : "💀 fallen";
    return `<div>${p.name} — ${p.archetype.name} — ${status}</div>`;
  }).join("");

  stats.innerHTML = `
    ${playerLines}
    <div style="margin-top:8px;">Level Reached: ${Math.min(state.levelIdx + 1, LEVELS.length)} / ${LEVELS.length}</div>
    <div>Correct: ${state.totalCorrect} / ${state.totalAnswered} (${accuracy}%)</div>
  `;

  show("end");
}

const deathQuotes = {
  final_girl: "Even the last girl runs out of nights.",
  virgin: "Purity wasn't enough this time.",
  jock: "Should've read more books.",
  joker: "The punchline was you.",
  nerd: "Knew everything. Except how to run.",
  skeptic: "You believe now."
};
const survivalQuotes = {
  final_girl: "You always knew it would come down to you.",
  virgin: "Dawn breaks. You are spared.",
  jock: "Turns out muscles AND trivia do matter.",
  joker: "You laughed your way out alive.",
  nerd: "Every movie you watched paid off.",
  skeptic: "You still don't believe. But you're alive."
};
</script>
