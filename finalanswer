    <div class="tag">&bull; answer or die &bull;</div>
    <div class="mode-btns">
      <button class="btn-main" onclick="chooseMode('solo')">Solo</button>
      <button class="btn-main" onclick="chooseMode('multi')">Multiplayer</button>
    </div>
