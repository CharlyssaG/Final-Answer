<script>
/* ======================================================================
   AUDIO
====================================================================== */
let audioCtx = null;
let audioEnabled = true;
let ambientNodes = [];
let heartbeatInterval = null;

function initAudio() {
  if (audioCtx) return;
  try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) { audioEnabled = false; }
}
function toggleAudio() {
  audioEnabled = !audioEnabled;
  document.getElementById("audio-toggle").textContent = audioEnabled ? "🔊" : "🔇";
  if (!audioEnabled) { stopAmbient(); stopHeartbeat(); }
}
function startAmbient() {
  if (!audioEnabled) return;
  initAudio(); if (!audioCtx) return;
  stopAmbient();
  const now = audioCtx.currentTime;
  const master = audioCtx.createGain();
  master.gain.setValueAtTime(0, now);
  master.gain.linearRampToValueAtTime(0.15, now + 2);
  master.connect(audioCtx.destination);

  const drone1 = audioCtx.createOscillator();
  drone1.type = "sawtooth"; drone1.frequency.setValueAtTime(55, now);
  const drone1Gain = audioCtx.createGain(); drone1Gain.gain.value = 0.3;
  const drone1Filter = audioCtx.createBiquadFilter();
  drone1Filter.type = "lowpass"; drone1Filter.frequency.value = 200;
  drone1.connect(drone1Filter).connect(drone1Gain).connect(master);
  drone1.start();

  const drone2 = audioCtx.createOscillator();
  drone2.type = "sine"; drone2.frequency.setValueAtTime(82, now);
  const drone2Gain = audioCtx.createGain(); drone2Gain.gain.value = 0.2;
  drone2.connect(drone2Gain).connect(master); drone2.start();

  const highOsc = audioCtx.createOscillator();
  highOsc.type = "triangle"; highOsc.frequency.setValueAtTime(220, now);
  const highGain = audioCtx.createGain(); highGain.gain.value = 0.04;
  const lfo = audioCtx.createOscillator(); lfo.frequency.value = 0.15;
  const lfoGain = audioCtx.createGain(); lfoGain.gain.value = 15;
  lfo.connect(lfoGain).connect(highOsc.frequency);
  highOsc.connect(highGain).connect(master);
  highOsc.start(); lfo.start();

  const bufSize = 2 * audioCtx.sampleRate;
  const noiseBuf = audioCtx.createBuffer(1, bufSize, audioCtx.sampleRate);
  const data = noiseBuf.getChannelData(0);
  for (let i = 0; i < bufSize; i++) data[i] = Math.random() * 2 - 1;
  const noise = audioCtx.createBufferSource();
  noise.buffer = noiseBuf; noise.loop = true;
  const noiseFilter = audioCtx.createBiquadFilter();
  noiseFilter.type = "bandpass"; noiseFilter.frequency.value = 400; noiseFilter.Q.value = 0.5;
  const noiseGain = audioCtx.createGain(); noiseGain.gain.value = 0.08;
  noise.connect(noiseFilter).connect(noiseGain).connect(master);
  noise.start();

  ambientNodes = [drone1, drone2, highOsc, lfo, noise, master];
}
function stopAmbient() {
  if (ambientNodes.length === 0) return;
  const now = audioCtx ? audioCtx.currentTime : 0;
  try {
    ambientNodes.forEach(n => {
      if (n.gain) {
        n.gain.cancelScheduledValues(now);
        n.gain.linearRampToValueAtTime(0, now + 0.5);
      }
    });
    setTimeout(() => {
      ambientNodes.forEach(n => { try { n.stop && n.stop(); } catch(e){} });
      ambientNodes = [];
    }, 600);
  } catch(e) {}
}
function startHeartbeat(bpm = 60) {
  if (!audioEnabled || !audioCtx) return;
  stopHeartbeat();
  const interval = 60000 / bpm;
  const beat = () => {
    if (!audioCtx || !audioEnabled) return;
    const now = audioCtx.currentTime;
    [0, 0.15].forEach((offset, i) => {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(60, now + offset);
      osc.frequency.exponentialRampToValueAtTime(30, now + offset + 0.15);
      gain.gain.setValueAtTime(0, now + offset);
      gain.gain.linearRampToValueAtTime(i === 0 ? 0.4 : 0.25, now + offset + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.2);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start(now + offset); osc.stop(now + offset + 0.25);
    });
  };
  beat();
  heartbeatInterval = setInterval(beat, interval);
}
function stopHeartbeat() {
  if (heartbeatInterval) { clearInterval(heartbeatInterval); heartbeatInterval = null; }
}
function playStinger(type) {
  if (!audioEnabled || !audioCtx) return;
  const now = audioCtx.currentTime;
  if (type === "wrong") {
    const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
    osc.type = "sawtooth";
    osc.frequency.setValueAtTime(200, now);
    osc.frequency.exponentialRampToValueAtTime(40, now + 0.6);
    gain.gain.setValueAtTime(0.3, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
    osc.connect(gain).connect(audioCtx.destination);
    osc.start(now); osc.stop(now + 0.6);
  } else if (type === "correct") {
    const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
    osc.type = "triangle";
    osc.frequency.setValueAtTime(440, now);
    osc.frequency.linearRampToValueAtTime(660, now + 0.15);
    gain.gain.setValueAtTime(0.15, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
    osc.connect(gain).connect(audioCtx.destination);
    osc.start(now); osc.stop(now + 0.3);
  } else if (type === "scare") {
    const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
