  </div>

  <!-- ======== MP SETUP ======== -->
  <div id="mp-setup" class="screen">
    <h2>How Many Victims?</h2>
    <div class="sub">&bull; hot-seat: pass the device each turn &bull;</div>
    <div class="player-count" id="player-count-btns">
      <div class="pc-btn" data-n="2" onclick="setPlayerCount(2)"><span class="num">2</span><span class="label">Friends</span></div>
      <div class="pc-btn" data-n="3" onclick="setPlayerCount(3)"><span class="num">3</span><span class="label">Targets</span></div>
      <div class="pc-btn" data-n="4" onclick="setPlayerCount(4)"><span class="num">4</span><span class="label">Corpses</span></div>
    </div>
    <div class="name-inputs" id="name-inputs"></div>
    <button class="btn-main" id="mp-continue" onclick="mpContinue()" style="opacity:0.3; pointer-events:none;">Choose Archetypes</button>
  </div>

  <!-- ======== CHARACTER SELECT ======== -->
  <div id="select" class="screen">
    <h2>Choose Your Fate</h2>
